# ==============================================================================
# DEV-PULSE - ESQUEMATICO DE VARIABLES DE ENTORNO (PLANTILLA PUBLICA)
# Duplica este archivo como '.env' en tu entorno local y asigna tus credenciales.
# NUNCA subas el archivo '.env' con valores reales al control de versiones.
# ==============================================================================

# Credenciales de acceso al coprocesador de IA (OpenAI)
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai-aqui
OPENAI_MODEL=gpt-4o-mini

# Seguridad de interrupciones externas (GitHub Webhook HMAC Secret)
GITHUB_WEBHOOK_SECRET=tu-token-secreto-compartido-de-github-aqui

# Configuracion operativa del runtime
ENVIRONMENT=development
PORT=8000